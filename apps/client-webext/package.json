{
  "name": "@inkcre/client-webext",
  "version": "0.2.0",
  "private": true,
  "description": "InKCre's Web extension",
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/dev.mjs webext",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:migration": "wxt zip --mode migration",
    "postinstall": "wxt prepare",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@inkcre/core": "workspace:*",
    "@inkcre/ui-web": "2.7.0",
    "@inkcre/web-collection": "workspace:*",
    "@mozilla/readability": "^0.6.0",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@wxt-dev/module-vue": "^1.0.2",
    "sass": "^1.93.3",
    "typescript": "catalog:",
    "vue-tsc": "catalog:",
    "wxt": "^0.20.6"
  }
}
